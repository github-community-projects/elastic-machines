{
  "name": "C# (.NET)",
  "dockerFile": "Dockerfile",
  "remoteUser": "vscode",
  "forwardPorts": [5000, 5001],
  "customizations": {
    "extensions": [
      "ms-dotnettools.csharp",
      "ms-vscode.powershell",
      "timonwong.shellcheck",
      "davidanson.vscode-markdownlint"
    ]
  },
  "features": {
    "ghcr.io/devcontainers/features/terraform:latest": {},
    "ghcr.io/devcontainers/features/powershell:latest": {},
    "ghcr.io/devcontainers/features/azure-cli:latest": {},
    "ghcr.io/devcontainers/features/aws-cli:latest": {}
  },
  "mounts": [
    "source=${localEnv:HOME}/.kube,target=/home/vscode/.kube,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.aws,target=/home/vscode/.aws,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.azure,target=/home/vscode/.azure,type=bind,consistency=cached"
  ]
}
