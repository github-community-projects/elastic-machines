{
  "ElasticMachines": {
    "PollingInterval": "01:00:00",
    "RepositoryConfigurationPath": ".github/elastic-machines.yml",
    "AccountConfigurationPath": "elastic-machines.yml",
    "AccountConfigurationRepositories": [
      ".github",
      ".github-internal",
      ".github-private"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information"
    },
    "Console": {
      "DisableColors": true
    }
  },
  "AllowedHosts": "*"
}
